    "@supabase/supabase-js": "^2.93.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "play-dl": "^1.9.7",
